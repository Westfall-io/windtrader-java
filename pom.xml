<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.westfall</groupId>
  <artifactId>windtrader-java</artifactId>
  <version>0.1.0</version>

  <licenses>
    <license>
      <name>Eclipse Public License 2.0</name>
      <url>https://www.eclipse.org/legal/epl-2.0/</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <sysml.version>0.62.0</sysml.version>
    <windtrader.sysmlVersion>${sysml.version}</windtrader.sysmlVersion>
  </properties>

  <repositories>
    <repository>
      <id>sysml-github</id>
      <url>https://maven.pkg.github.com/Systems-Modeling/SysML-v2-Pilot-Implementation</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Headless distribution with Xtext + SysML bits -->
    <dependency>
      <groupId>org.omg.sysml</groupId>
      <artifactId>org.omg.sysml.interactive</artifactId>
      <version>${sysml.version}</version>
      <classifier>all</classifier>
      <exclusions>
        <!-- The pilot's `-all` uberjar is self-contained: it shades ALL of its own
             transitives (model/logic/sysml/plantuml classes, Xtext/EMF/Guice, and the
             .ecore/resources) into a single jar. Its pom, however, still declares
             internal transitive artifacts that are NOT resolvable from GH Packages
             (some have `system`-scope pointing at the pilot's own CI runner paths;
             `sysml`/`plantuml` 0.62.0-SNAPSHOT are unpublished). The wildcard exclusion
             states intent: take nothing else from this pom — everything the runtime
             needs is already shaded in the uberjar.
             REMOVE-CONDITION: drop this exclusion (or narrow it back to named
             artifacts) once the pilot publishes resolvable poms for those bundles —
             i.e. when a 0.62.0+ build works without it. Verified: model/logic/plantuml
             classes + 52 .ecore are inside the -all jar. -->
        <exclusion>
          <groupId>*</groupId>
          <artifactId>*</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>

  <build>
    <resources>
    <resource>
      <directory>src/main/resources</directory>
      <filtering>true</filtering>
    </resource>
  </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals><goal>shade</goal></goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>

              <!-- Prevent signature digest issues from shaded deps -->
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                  </excludes>
                </filter>
              </filters>

              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>io.westfall.windtrader.RoundTrip</mainClass>
                  <manifestEntries>
                    <Windtrader-SysML-Version>${windtrader.sysmlVersion}</Windtrader-SysML-Version>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
